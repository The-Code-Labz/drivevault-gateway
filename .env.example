PORT=4050
NODE_ENV=production

# Optional API key for S3-compatible endpoints and web API mutations.
# Leave blank to allow anonymous access (safe only on private networks).
API_KEY=

# CORS origin for the web UI.
CORS_ORIGIN=*

# --- Auth: pick ONE of the two modes below ------------------------------
#
# Mode 1 — Service account (requires a Google WORKSPACE org + a real Shared
# Drive). Service accounts have zero storage quota of their own.
#
# Option A: paste the full JSON object (single line):
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Option B: path to a JSON file inside the container.
# MUST be a path inside the container (not a host path!) — place the actual
# file at ./data/service-account.json on the host, and docker-compose.yml
# will bind-mount it to exactly this path automatically:
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/app/data/service-account.json
#
# Mode 2 — OAuth user credentials (use this for a PERSONAL Gmail account —
# Shared Drives and domain-wide delegation don't exist outside Workspace).
# Uploads run as the authorized human user against their own My Drive quota.
# Set only the CLIENT_ID/SECRET here (a "Web application" OAuth client from
# Cloud Console — these never expire, safe to leave in .env), then visit
# /api/oauth/connect in a browser once to complete login — the refresh token
# is written to ./data/oauth-tokens.json automatically, no manual paste, no
# restart. See README.md "Mode 2 — OAuth user credentials" for the full
# walkthrough, including why the OAuth consent screen must be Published
# (Testing mode caps refresh tokens at 7 days). When CLIENT_ID/SECRET are
# set, GOOGLE_SERVICE_ACCOUNT_JSON(_PATH) above is ignored.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public base URL DriveVault is reachable at — must exactly match the
# redirect URI registered on the OAuth client (<this>/api/oauth/callback).
OAUTH_REDIRECT_BASE_URL=
# Only needed for the terminal-fallback scripts (npm run oauth:token /
# oauth:token:device) — leave blank when using /api/oauth/connect.
GOOGLE_OAUTH_REFRESH_TOKEN=
# --------------------------------------------------------------------------

# The Google Drive folder that acts as the root for all buckets.
# Service account mode: MUST be a folder ID inside a Shared Drive the
# service account has been added to (as Content Manager or higher). Do NOT
# leave this as "root" — uploads into the service account's own My Drive
# will fail with storageQuotaExceeded on the very first PUT, even though
# folder creation still succeeds.
# OAuth mode: any regular folder ID in the authorized user's own Drive, or
# leave blank/"root" to use their My Drive root directly — both work fine,
# since the human user actually has storage quota.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# S3-compatible endpoint advertised to clients.
S3_ENDPOINT=https://drivevault.example.com
S3_REGION=us-east-1

# Frontend env (used at build time for the web UI).
VITE_API_BASE_URL=
VITE_API_KEY=
